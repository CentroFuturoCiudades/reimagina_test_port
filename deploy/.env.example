# Imagen construida con el Dockerfile de la raíz (local o en el ACR).
REIMAGINA_LYRA_IMAGE=reimagina-lyra:0.1.0
LYRA_CONFIG_FILE=./lyra.toml
# Secretos distintos y aleatorios, p.ej. `openssl rand -hex 32`.
LYRA_AGENT_API_KEY=replace-with-a-random-agent-secret
LYRA_ADMIN_API_KEY=replace-with-a-different-admin-secret
# BD de Reimagina, solo para el worker. TLS por defecto; local: ?sslmode=disable.
REIMAGINA_POSTGRES_DSN=postgresql://user:password@host:5432/reimagina
